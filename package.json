{
  "name": "bilimusic",
  "version": "5.2.0",
  "description": "BiliMusic Aurora v5.2 - 哔哩哔哩音乐播放器 (Electron 桌面版)",
  "main": "src/main.js",
  "author": "BiliMusic",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "node scripts/build-release.js",
    "build:minor": "node scripts/build-release.js --minor",
    "build:major": "node scripts/build-release.js --major",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.bilimusic.app",
    "productName": "BiliMusic",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BiliMusic"
    }
  },
  "dependencies": {
    "7zip-bin": "^5.2.0"
  }
}
